//=============================================================================
// RocketArenaV2Media: the menu and F2 textures of Rocket Arena V2.
// Generated by tools/make_media.py. A separate package, so code updates of
// RocketArenaV2 do not make clients download the graphics again.
// Rebuild it only when the art changes (./build.sh --media), and then give it a
// new name: clients cache packages by name and GUID.
//=============================================================================
class RocketArenaV2Media extends Object
	abstract;

